{
  "name": "pebric-monorepo",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=18.0.0 <21.0.0"
  },
  "scripts": {
    "build": "turbo run build && node -e \"const fs=require('fs'); if(fs.existsSync('apps/web/dist')) fs.cpSync('apps/web/dist', 'dist', {recursive: true});\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "kafka:relay": "npm run relay --workspace @pebric/kafka-relay",
    "kafka:relay:build": "npm run build --workspace @pebric/kafka-relay",
    "kafka:relay:check": "npm run check --workspace @pebric/kafka-relay"
  },
  "devDependencies": {
    "prettier": "latest",
    "turbo": "latest"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0"
  }
}
